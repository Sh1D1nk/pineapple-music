{
  "name": "pineapple-music",
  "productName": "Pineapple Music",
  "version": "1.4.2",
  "description": "Windows 桌面音乐播放器：Apple Music 版式 + 液态玻璃 + AMLL 歌词 + AutoMix 过渡",
  "author": "Sh1D1nk",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "compile": "electron-vite build",
    "build": "npm run compile && electron-builder --win nsis",
    "build:dir": "npm run compile && electron-builder --win --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "fixtures": "node scripts/make-fixtures.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "verify": "npm run compile && node scripts/verify.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "node scripts/bump-version.mjs && npm run build",
    "publish:github": "git push -u origin main && git push --tags"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "0.6.0",
    "@applemusic-like-lyrics/lyric": "1.1.0",
    "@applemusic-like-lyrics/react": "0.6.0",
    "@pixi/app": "7.4.3",
    "@pixi/core": "7.4.3",
    "@pixi/display": "7.4.3",
    "@pixi/filter-blur": "7.4.3",
    "@pixi/filter-bulge-pinch": "5.1.1",
    "@pixi/filter-color-matrix": "7.4.3",
    "@pixi/sprite": "7.4.3",
    "@tanstack/react-virtual": "3.14.22",
    "better-sqlite3": "13.0.3",
    "chardet": "2.2.0",
    "iconv-lite": "0.7.3",
    "music-metadata": "12.2.3",
    "pinyin-pro": "^3.29.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "signalsmith-stretch": "1.3.2",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0",
    "onnxruntime-node": "^1.30.0"
  },
  "homepage": "https://github.com/Sh1D1nk/pineapple-music#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sh1D1nk/pineapple-music.git"
  },
  "keywords": [
    "windows",
    "music-player",
    "electron",
    "amll",
    "automix",
    "liquid-glass"
  ]
}

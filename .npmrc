# @applemusic-like-lyrics/core declares its @pixi/* peers as "*", which makes npm's
# peer resolution crash (arborist "Cannot read properties of null (reading 'edgesOut')").
# The concrete pixi 7 versions are pinned in package.json instead.
legacy-peer-deps=true
audit=false
fund=false

# Electron's binary is fetched from GitHub releases by default; the npmmirror copy is a lot more
# reliable from mainland China and is byte-identical. Override by setting ELECTRON_MIRROR.
electron_mirror=https://npmmirror.com/mirrors/electron/
